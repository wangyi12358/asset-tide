# Generate .env.docker with: node scripts/docker-init.mjs
# Local testing: http://localhost:3000 ; public deployment: https://assets.example.com
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
# Generated password uses URL-safe characters. Encode special characters in custom passwords.
POSTGRES_PASSWORD=
POSTGRES_DB=asset_atlas
APP_BIND=127.0.0.1
APP_PORT=3000
# Required only with compose.https.yaml; use a domain pointed to this server.
DOMAIN=
ENABLE_SCHEDULER=true
COINGECKO_API_KEY=
TWELVE_DATA_API_KEY=
# LongPort Hong Kong quotes (server only). Get API Key credentials at https://open.longportapp.com/
LONGPORT_APP_KEY=
LONGPORT_APP_SECRET=
LONGPORT_ACCESS_TOKEN=
TUSHARE_TOKEN=
RESEND_API_KEY=
MAIL_FROM=
