{
  "name": "asset-atlas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "prisma generate && next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "db:backup": "tsx scripts/backup.ts",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "test:browser": "node scripts/browser-check.mjs",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:setup": "prisma migrate deploy && prisma db seed",
    "db:import-sqlite": "tsx scripts/migrate-sqlite.ts",
    "db:studio": "prisma studio",
    "test:benchmark": "tsx --test scripts/benchmark.ts"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@heroui/react": "^3.2.5",
    "@heroui/styles": "^3.2.5",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@tailwindcss/postcss": "^4.3.3",
    "better-auth": "^1.7.5",
    "decimal.js": "^10.6.0",
    "hono": "^4.13.8",
    "lucide-react": "^1.47.0",
    "next": "^16.3.5",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "swr": "^2.5.1",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.9.7",
    "prisma": "7.10.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "better-sqlite3": "^13.0.3"
  },
  "packageManager": "pnpm@11.12.0"
}
