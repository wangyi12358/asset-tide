BETTER_AUTH_URL=http://localhost:3000
# Generate using: openssl rand -base64 48
BETTER_AUTH_SECRET=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/asset_atlas
# Neon: DATABASE_URL uses the pooled (-pooler) host; DIRECT_URL uses the direct host.
# Migrations and local pg_dump prefer DIRECT_URL. Leave unset for local PostgreSQL.
DIRECT_URL=
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/asset_atlas_test
# Optional, if pg_dump is not available on PATH:
# PG_DUMP_PATH=/path/to/pg_dump
BACKUP_PATH=./backups
# Local development only: emails are saved in data/mailbox, never printed to logs.
# Production requires RESEND_API_KEY and MAIL_FROM.
RESEND_API_KEY=
MAIL_FROM=AssetAtlas <hello@example.com>
COINGECKO_API_KEY=
TWELVE_DATA_API_KEY=
# LongPort Hong Kong quotes (server only). Get API Key credentials at https://open.longportapp.com/
LONGPORT_APP_KEY=
LONGPORT_APP_SECRET=
LONGPORT_ACCESS_TOKEN=
TUSHARE_TOKEN=
# Single persistent Node instance only. Disable for tests or externally managed jobs.
# Vercel always disables the in-process scheduler, even if this is true.
ENABLE_SCHEDULER=true
# Vercel daily snapshot endpoint. Generate a separate random secret (32+ characters).
CRON_SECRET=
